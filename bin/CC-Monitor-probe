#!/usr/bin/env python3
import os
import platform
import sys

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))

if __name__ == "__main__":
    if platform.system() == "Darwin":
        # macOS samples with nettop (cc_monitor/probe_darwin.py); a normal user can run it, no root needed.
        from cc_monitor.probe_darwin import run
        run()
    else:
        from cc_monitor.probe import run

        if os.name == "posix" and hasattr(os, "geteuid") and os.geteuid() != 0:
            print("[CC-Monitor] The system-layer probe needs root (bpftrace requires it). Run it with sudo.", file=sys.stderr)
            sys.exit(1)
        run()
