#!/usr/bin/env bpftrace
// CC-Monitor system-layer probe (Linux / eBPF)
//
// Independent of Claude Code's own hooks: traces, directly in the kernel, execve (what command
// really ran) and connect (which IP:port was really contacted) across the whole process tree
// spawned from the `claude` process.
// Used to cross-check whether the application-layer hooks were bypassed or tampered with. Hooks
// are self-reported; this is an independent third-party observation.
//
// Boundary detection: after a child is forked and before it execs a new program, its comm is
// still inherited from the parent ("claude"); once that child execves another program (say
// /bin/bash), that is proof it was spawned from Claude Code.
// From then on sched_process_fork propagates this lineage to every later descendant.

BEGIN
{
    printf("READY\n");
}

tracepoint:sched:sched_process_fork
/@watch[args.parent_pid]/
{
    @watch[args.child_pid] = 1;
}

tracepoint:syscalls:sys_enter_execve
{
    if (comm == "claude") {
        @watch[pid] = 1;
    }
    if (@watch[pid]) {
        printf("EXEC\t%d\t%d\t%s\t", pid, uid, comm);
        join(args.argv);
    }
}

// The first argument of libc's getaddrinfo(node, ...) is the domain the application actually
// wants to resolve (e.g. "api.anthropic.com"). Far more reliable than reverse DNS (PTR record) on
// the connected IP afterwards: many cloud/CDN egress IPs have no PTR at all, so a reverse lookup
// can never yield a domain, whereas this captures "what was asked at the time", so the domain is
// known before the connection happens. We keep the latest queried domain per pid and look it up
// on CONNECT. Node.js resolves DNS on libuv worker threads, but bpftrace's pid builtin is the
// thread group ID (same as getpid()), which equals the value for the main thread that calls
// connect(), so they match.
uprobe:libc:getaddrinfo
/@watch[pid]/
{
    @dns_query[pid] = str(arg0);
}

// Both AF_INET(2) and AF_INET6(10) must be recognised. Previously only AF_INET was checked, so on
// IPv6-enabled machines (today most cloud hosts and home broadband have it on by default, and many
// API domains also have AAAA records) not a single v6 connection was recorded. Not an error but a
// silent observation blind spot, harder to notice than a false negative.
// The port is a 16-bit network-order value in both families and converts the same way; the address
// differs: v4 is a 32-bit integer, v6 a 16-byte array, and ntop() formats both.
tracepoint:syscalls:sys_enter_connect
/@watch[pid]/
{
    $sa = (struct sockaddr *) args.uservaddr;
    if ($sa->sa_family == 2) {
        $sin = (struct sockaddr_in *) $sa;
        $port = ($sin->sin_port >> 8) | (($sin->sin_port << 8) & 0xff00);
        printf("CONNECT\t%d\t%d\t%s\t%s\t%d\t%s\n", pid, uid, comm, ntop($sin->sin_addr.s_addr), $port, @dns_query[pid]);
    }
    if ($sa->sa_family == 10) {
        $sin6 = (struct sockaddr_in6 *) $sa;
        $port6 = ($sin6->sin6_port >> 8) | (($sin6->sin6_port << 8) & 0xff00);
        printf("CONNECT\t%d\t%d\t%s\t%s\t%d\t%s\n", pid, uid, comm, ntop($sin6->sin6_addr.in6_u.u6_addr8), $port6, @dns_query[pid]);
    }
}

// Traffic byte counts. CONNECT above only knows "which IP:port was contacted", not how much data
// moved. TCP send/receive bytes come from these two kernel functions: tcp_sendmsg is the send path
// (the third argument is the number of bytes being sent), and tcp_cleanup_rbuf is called when the
// application takes data from the kernel receive buffer (the second argument is the number of
// bytes taken; with no data, a pure ACK and the like it is 0 or negative, and negatives must be
// checked as signed int32, otherwise bpftrace reads them as unsigned 64-bit by default and they
// become astronomically large).
// Both probe points read the destination address straight from `struct sock`: the kernel socket
// already knows its peer, so there is no need for an fd -> destination map as with CONNECT events.
// Not reported per packet (far too much volume): accumulated for 2 seconds and emitted together,
// the same idea as top-style tools.
kprobe:tcp_sendmsg
/@watch[pid]/
{
    $sk = (struct sock *)arg0;
    $size = (int32)arg2;
    $dport_raw = $sk->__sk_common.skc_dport;
    $dport = ($dport_raw >> 8) | (($dport_raw << 8) & 0xff00);
    if ($sk->__sk_common.skc_family == 2 && $size > 0) {
        @tx_bytes[ntop($sk->__sk_common.skc_daddr), $dport] = sum($size);
    }
    // The IPv6 destination address is in skc_v6_daddr (the v4 skc_daddr is 0 on a v6 socket);
    // otherwise all v6 traffic would pile up on the bogus address "0.0.0.0".
    if ($sk->__sk_common.skc_family == 10 && $size > 0) {
        @tx_bytes[ntop($sk->__sk_common.skc_v6_daddr.in6_u.u6_addr8), $dport] = sum($size);
    }
}

kprobe:tcp_cleanup_rbuf
/@watch[pid]/
{
    $sk = (struct sock *)arg0;
    $copied = (int32)arg1;
    $dport_raw = $sk->__sk_common.skc_dport;
    $dport = ($dport_raw >> 8) | (($dport_raw << 8) & 0xff00);
    if ($sk->__sk_common.skc_family == 2 && $copied > 0) {
        @rx_bytes[ntop($sk->__sk_common.skc_daddr), $dport] = sum($copied);
    }
    if ($sk->__sk_common.skc_family == 10 && $copied > 0) {
        @rx_bytes[ntop($sk->__sk_common.skc_v6_daddr.in6_u.u6_addr8), $dport] = sum($copied);
    }
}

interval:s:2
{
    print(@tx_bytes);
    print(@rx_bytes);
    clear(@tx_bytes);
    clear(@rx_bytes);
}

tracepoint:sched:sched_process_exit
/@watch[pid]/
{
    delete(@watch[pid]);
    delete(@dns_query[pid]);
}
